PORT=4000
JWT_SECRET=change_this_to_a_long_random_secret_before_deploying
JWT_EXPIRES_IN=8h
DB_PATH=./db/smartbank.sqlite


# No default accounts are nedded. To register as staff or admin (instead of
# the public "customer" role), the registration form must be given one of these codes

STAFF_SIGNUP_CODE=STF-194
ADMIN_SIGNUP_CODE=ADM-194

EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your_gmail_app_password